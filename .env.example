# Optional provider credentials. Keep secrets only in Vercel/server environment variables.
# Speech-to-text provider: openai (recommended alternative) or huggingface.
# OpenAI transcription API is paid; set TRANSCRIPTION_PROVIDER=openai and OPENAI_API_KEY.
TRANSCRIPTION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
# Optional ISO-639-1 language code (for example hr, sr, bs). Leave blank for automatic detection.
TRANSCRIPTION_LANGUAGE=
# Legacy alternative; only used when TRANSCRIPTION_PROVIDER=huggingface.
HUGGINGFACE_TOKEN=
STABILITY_API_KEY=
MUREKA_API_KEY=
LALAL_API_KEY=
AUDIOSHAKE_API_KEY=
ROEX_API_KEY=

# Optional self-hosted audio worker endpoint (do not expose it to browser code).
MUSIC_API_URL=
MUSIC_API_KEY=
REPLICATE_API_TOKEN=
REPLICATE_MODEL=

# Optional OpenAI-compatible LLM for conservative Lyrics Refine.
# Base URL normally ends in /v1; the server appends /chat/completions.
# Keep keys server-side. Local URLs work only when reachable from the Next.js server.
LYRICS_LLM_BASE_URL=
LYRICS_LLM_API_KEY=
LYRICS_LLM_MODEL=
